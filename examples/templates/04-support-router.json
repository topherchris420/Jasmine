        "values": {
          "nodeName": "Billing reply",
          "prompts": [
            {
              "id": "s",
              "role": "system",
              "content": "You are a billing specialist. Reply briefly and politely."
            },
            {
              "id": "u",
              "role": "user",
              "content": "{{triggerNode_1.output.message}}"
            }
          ],
          "messages": "[]",
          "memories": "[]",
          "tools": []
