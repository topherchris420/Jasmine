{
  "meta": {
    "name": "Support Ticket Router",
    "description": "A local model classifies each ticket and routes it to a specialised reply.",
    "category": "Agents",
    "useCase": "Triage support tickets into billing, technical or other, each with a tailored first reply.",
    "input": "{\"message\": \"I was charged twice\"}",
    "output": "{\"category\": \"billing\", \"reply\": \"…\"}"
  },
  "nodes": [
    {
      "id": "triggerNode_1",
      "type": "triggerNode",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "nodeId": "graphqlNode",
        "values": {
          "nodeName": "API Request",
          "responeType": "realtime",
          "advance_schema": "{\n  \"message\": \"string\"\n}"
        },
        "trigger": true
      }
    },
    {
      "id": "agentClassifierNode_1",
      "type": "agentClassifierNode",
      "position": {
        "x": 0,
        "y": 150
      },
      "data": {
        "nodeId": "agentClassifierNode",
        "values": {
          "nodeName": "Classify",
          "prompts": [
            {
              "id": "user",
              "role": "user",
              "content": "Ticket: {{triggerNode_1.output.message}}"
            }
          ],
          "classifier": [
            {
              "label": "Billing",
              "value": "billing",
              "description": "payments, invoices, refunds"
            },
            {
              "label": "Technical",
              "value": "technical",
              "description": "bugs, errors, how-to"
            },
            {
              "label": "Other",
              "value": "other"
            }
          ]
        }
      }
    },
    {
