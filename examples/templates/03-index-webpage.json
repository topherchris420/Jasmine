{
  "meta": {
    "name": "Index a Web Page",
    "description": "Scrape a URL, split it into chunks, embed them locally and store them in the \"handbook\" vector database.",
    "category": "RAG"
  },
  "nodes": [
    {
      "id": "triggerNode_1",
      "type": "triggerNode",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "nodeId": "graphqlNode",
        "values": {
          "nodeName": "API Request",
          "responeType": "realtime",
          "advance_schema": "{\n  \"url\": \"string\"\n}"
        },
        "trigger": true
      }
    },
    {
      "id": "scraperNode_1",
      "type": "dynamicNode",
      "position": {
        "x": 0,
        "y": 140
      },
      "data": {
        "nodeId": "scraperNode",
        "values": {
          "nodeName": "Web Scraper",
          "url": "{{triggerNode_1.output.url}}",
          "onlyMainContent": true
        }
      }
    },
    {
      "id": "chunkNode_1",
      "type": "dynamicNode",
      "position": {
        "x": 0,
        "y": 280
      },
      "data": {
        "nodeId": "chunkNode",
        "values": {
          "nodeName": "Chunking",
          "chunkField": "{{scraperNode_1.output.markdown}}",
          "chunkingType": "recursiveCharacterTextSplitter",
          "numOfChars": 800,
          "overlapChars": 100,
          "separators": [
            "\n\n",
            "\n",
            " "
          ]
        }
      }
    },
    {
      "id": "codeNode_1",
      "type": "dynamicNode",
      "position": {
        "x": 0,
        "y": 420
      },
      "data": {
        "nodeId": "codeNode",
        "values": {
          "nodeName": "Build objects",
          "code": "const chunks = {{chunkNode_1.output.chunks}};\nconst title = {{scraperNode_1.output.title}};\nconst source = {{scraperNode_1.output.url}};\noutput = { metadata: chunks.map((c, i) => ({ content: c.pageContent, title, source, chunk: i })) };"
        }
      }
    },
    {
      "id": "IndexNode_1",
      "type": "dynamicNode",
      "position": {
        "x": 0,
        "y": 560
      },
      "data": {
        "nodeId": "IndexNode",
        "values": {
          "nodeName": "Index",
          "vectorDB": "handbook",
          "vectorsField": "",
          "metadataField": "{{codeNode_1.output.metadata}}",
          "primaryKeys": [
            "source",
            "chunk"
          ],
          "duplicateOperation": "overwrite"
        }
      }
    },
    {
      "id": "responseNode_triggerNode_1",
      "type": "responseNode",
      "position": {
        "x": 0,
        "y": 700
      },
      "data": {
        "nodeId": "graphqlResponseNode",
        "values": {
          "nodeName": "API Response",
          "outputMapping": "{\n  \"indexed\": \"{{IndexNode_1.output.recordsIndexed}}\",\n  \"title\": \"{{scraperNode_1.output.title}}\"\n}"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "triggerNode_1-scraperNode_1",
      "source": "triggerNode_1",
      "target": "scraperNode_1",
      "type": "defaultEdge",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "scraperNode_1-chunkNode_1",
      "source": "scraperNode_1",
      "target": "chunkNode_1",
      "type": "defaultEdge",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "chunkNode_1-codeNode_1",
      "source": "chunkNode_1",
      "target": "codeNode_1",
      "type": "defaultEdge",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "codeNode_1-IndexNode_1",
      "source": "codeNode_1",
      "target": "IndexNode_1",
      "type": "defaultEdge",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "IndexNode_1-responseNode_triggerNode_1",
      "source": "IndexNode_1",
      "target": "responseNode_triggerNode_1",
      "type": "defaultEdge",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "response-responseNode_triggerNode_1",
      "source": "triggerNode_1",
      "target": "responseNode_triggerNode_1",
      "type": "responseEdge",
      "sourceHandle": "to-response",
      "targetHandle": "from-trigger"
    }
  ]
}
