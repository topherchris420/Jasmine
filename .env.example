# Persistent Node runtime (copy values to your host's environment, not to Git).
HOST=0.0.0.0
PORT=8787
JASMINE_DATA_DIR=/data
JASMINE_API_KEY=
JASMINE_SECRET_KEY=
JASMINE_GATEWAY_SECRET=
PUBLIC_URL=https://your-jasmine.vercel.app
# Models can also be configured in Studio. Cloud hosts cannot reach your laptop's localhost.
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-model-server.example/v1
LLM_API_KEY=
LLM_MODEL=

# Vercel only: fixed HTTPS address of the persistent Node runtime.
# Also set JASMINE_GATEWAY_SECRET to the same random value used by the runtime.
JASMINE_RUNTIME_URL=https://your-runtime.example
